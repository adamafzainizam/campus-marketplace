// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  /// Defaults to USER, so every existing row keeps exactly the privileges it
  /// had. There is no route that grants ADMIN — see `scripts/make-admin.ts`,
  /// which is deliberately not reachable from the internet.
  role UserRole @default(USER)

  /// Non-null means suspended. A timestamp rather than a boolean because
  /// "when" is the first thing anyone asks when reviewing a suspension, and
  /// it costs nothing to keep.
  suspendedAt     DateTime?
  /// Shown to the suspended user. They are entitled to know why.
  suspendedReason String?

  accounts Account[]
  sessions Session[]
  listings Listing[]

  conversationsAsBuyer Conversation[]
  messages             Message[]
  conversationReads    ConversationRead[]

  moderationActions ModerationLog[] @relation("ModerationActor")
  moderationRecord  ModerationLog[] @relation("ModerationSubject")

  reportsMade     Report[] @relation("Reporter")
  reportsResolved Report[] @relation("ReportResolver")

  @@map("users")
}

/// Something a user has flagged for an administrator to look at.
///
/// The target is a type plus a free string id rather than real foreign keys,
/// matching `ModerationLog` and for the same reason: a report has to survive
/// its target. A report about a listing that has since been archived is still
/// the record of somebody raising a concern.
model Report {
  id String @id @default(cuid())

  reporterId String
  reporter   User   @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  targetType ModerationTargetType
  targetId   String

  reason ReportReason
  /// Optional free text. The reason enum carries the category; this is for the
  /// detail a category cannot express ("they asked me to pay before meeting").
  detail String?

  status ReportStatus @default(OPEN)

  createdAt DateTime @default(now())

  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     User?     @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  /// What the administrator decided and why, readable by nobody but them.
  resolutionNote String?

  /// One report per person per thing. Without this, one aggrieved user can
  /// file the same complaint fifty times and bury everything else in the
  /// queue — the queue being the scarce resource when there is one moderator.
  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@map("reports")
}

/// Why something was reported. Mirrors the sections of the Acceptable Use
/// Policy deliberately, so the categories people choose from and the rules
/// they are being measured against cannot drift apart.
enum ReportReason {
  PROHIBITED_ITEM
  ACADEMIC_INTEGRITY
  SCAM
  HARASSMENT
  SPAM
  IMPERSONATION
  OTHER
}

enum ReportStatus {
  OPEN
  /// Looked at, and something was done — the action itself is in ModerationLog.
  ACTIONED
  /// Looked at, and nothing needed doing.
  DISMISSED
}

/// Append-only record of every moderation action taken.
///
/// This table is written and read, never updated or deleted — there is no code
/// path that does either, which is what makes it evidence rather than notes.
/// Every write happens in the same transaction as the action it describes, so
/// an unlogged moderation action is not merely discouraged but impossible.
model ModerationLog {
  id     String           @id @default(cuid())
  action ModerationAction

  /// Who acted. Restrict rather than Cascade: deleting an administrator must
  /// not quietly erase the record of what they did.
  adminId String
  admin   User   @relation("ModerationActor", fields: [adminId], references: [id], onDelete: Restrict)

  /// What was acted on. Stored as a type plus a free string id rather than as
  /// real foreign keys, because the log has to outlive its target — a record
  /// that vanishes when the listing does is not an audit trail.
  targetType ModerationTargetType
  targetId   String

  /// The affected user, where there is one, so a person's history can be
  /// pulled up in a single query. Nullable: a listing takedown targets a
  /// listing, and the seller is recorded here as the subject.
  subjectId String?
  subject   User?   @relation("ModerationSubject", fields: [subjectId], references: [id], onDelete: Restrict)

  /// Why. Required, including for reversals — an action without a stated
  /// reason is not reviewable later, which is most of the point of logging it.
  reason String

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([subjectId, createdAt])
  @@map("moderation_logs")
}

/// Ordinary users and administrators. Deliberately only two levels: a
/// permission hierarchy nobody needs is a source of bugs, not of safety.
enum UserRole {
  USER
  ADMIN
}

enum ModerationTargetType {
  LISTING
  USER
  MESSAGE
  REPORT
}

enum ModerationAction {
  LISTING_REMOVED
  USER_SUSPENDED
  USER_REINSTATED
  /// Viewing reported message content is itself a logged action, written
  /// before the content is returned. That is what keeps "moderators may read
  /// reported messages" a bounded power whose use is on the record, rather
  /// than a standing licence to read private conversations.
  MESSAGE_VIEWED
  /// Closing a report without acting on it. Logged so that deciding to do
  /// nothing is as reviewable as deciding to act — the decision an unaccountable
  /// moderator is most likely to make badly is the one nobody records.
  REPORT_DISMISSED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Category {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  listings Listing[]

  @@map("categories")
}

model Listing {
  id          String           @id @default(cuid())
  title       String
  description String
  price       Decimal          @db.Decimal(10, 2)
  condition   ListingCondition
  status      ListingStatus    @default(AVAILABLE)

  /// Defaults to SALE so every pre-existing listing keeps its meaning: they
  /// were all created when selling was the only thing the app could express.
  type         ListingType   @default(SALE)
  /// Set only when type is RENT; enforced in application code rather than by
  /// the database, since Postgres cannot express a conditional NOT NULL here
  /// without a CHECK constraint Prisma would not manage.
  rentalPeriod RentalPeriod?
  imageUrl     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  /// What the seller typed when they picked "Other".
  ///
  /// Set only when the chosen category is the catch-all, and enforced in
  /// application code rather than by a database CHECK constraint Prisma would
  /// not manage — the same arrangement as `rentalPeriod`.
  ///
  /// Worth keeping beyond display: a list of what people file under "Other" is
  /// the evidence for which categories to add next, and the only way to gather
  /// it is to ask at the moment they need one.
  otherCategory String?

  conversations Conversation[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@index([type])
  @@map("listings")
}

/// One thread per (listing, buyer) pair — the model eBay, Carousell and
/// Facebook Marketplace all use, so "is this still available?" is never
/// ambiguous. The seller is NOT stored here; it is derived from
/// listing.sellerId, which keeps a single source of truth for who owns a
/// listing.
model Conversation {
  id        String   @id @default(cuid())
  listingId String
  buyerId   String
  createdAt DateTime @default(now())
  /// Bumped on every new message so the inbox can order by recency without
  /// aggregating over the messages table.
  updatedAt DateTime @updatedAt

  /// Restrict, matching Listing's own relations: deleting a listing that still
  /// has conversations should force an explicit decision rather than silently
  /// destroying message history.
  listing Listing @relation(fields: [listingId], references: [id])
  buyer   User    @relation(fields: [buyerId], references: [id])

  messages Message[]
  reads    ConversationRead[]

  @@unique([listingId, buyerId])
  @@index([buyerId])
  @@index([updatedAt])
  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String   @db.Text
  createdAt      DateTime @default(now())

  /// Cascade: messages are meaningless without their conversation, the same
  /// reasoning Account/Session use from User.
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// Read state per participant. A row per participant rather than
/// buyerLastReadAt/sellerLastReadAt columns: there are only ever two
/// participants, but columns would force an "am I buyer or seller?" branch
/// into every read and write, and that conditional is where unread-count bugs
/// live.
model ConversationRead {
  conversationId String
  userId         String
  lastReadAt     DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("conversation_reads")
}

/// Rate-limit counters. In Postgres rather than memory because Vercel runs
/// multiple serverless instances that cold-start freely — an in-memory counter
/// would grant a fresh budget per instance. See src/lib/rate-limit.ts.
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  windowEnd DateTime

  @@index([windowEnd])
  @@map("rate_limits")
}

enum ListingCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  WORN
}

enum ListingStatus {
  AVAILABLE
  /// Someone has committed but the handover hasn't happened. Renamed from
  /// PENDING, which described the seller's paperwork rather than the item.
  RESERVED
  /// Terminal for a sale; for a rental this is displayed as "Rented out",
  /// since the vocabulary differs but the state does not.
  SOLD
  /// Withdrawn by the seller. Exists because deleting a listing is blocked by
  /// design when it has conversations (Conversation -> Listing is
  /// onDelete: Restrict), so this is how a seller retires a listing without
  /// destroying message history the other party may still want.
  ARCHIVED
}

/// Whether the seller is selling the item outright or renting it out.
/// The project has described itself as buy/sell/rent from the start, but
/// nothing in the data model could express a rental until now.
enum ListingType {
  SALE
  RENT
}

/// The unit a rental price is quoted in, so "RM20" is unambiguous.
/// SEMESTER is included because it is the natural unit on a campus.
enum RentalPeriod {
  DAY
  WEEK
  MONTH
  SEMESTER
}
